\ Convert 98.6°F to Celsius: C = (F - 32) * 5 / 9
98.6 32 - 5 * 9 / .        \ => 37.0
cr

\ Print "Hello, World!"
72 emit                    \ H
101 emit                   \ e
108 emit                   \ l
108 emit                   \ l
111 emit                   \ o
44 emit                    \ ,
32 emit                    \ (space)
87 emit                    \ W
111 emit                   \ o
114 emit                   \ r
108 emit                   \ l
100 emit                   \ d
33 emit                    \ !
cr

\ ---

\ Now compute simple compound interest, 1 period:
\ amount = principal * (1 + rate), rate = 0.05, principal = 1000
1000 1.05 * .              \ => 1050
cr

\ Demonstrate reuse of a value without re-entering it,
\ using dup to compute both the square and cube of 4
4 dup dup * .              \ => 16  (4^2)
cr
4 dup dup * * .            \ => 64  (4^3)
cr

\ Use swap + over to compute (a - b) and (a + b) from the same two inputs
7 3 over over              \ stack: 7 3 7 3
+ .                        \ => 10  (7+3)
cr
swap - .                   \ => -4  (3-7)
cr

\ ---
\ Definitions:  : name ... ;
\ A word is defined by naming it after `:` and closing with `;`.
: square  dup * ;          \ square of a number
5 square .                 \ => 25
cr

: greet                    \ a word that prints a message
  72 emit 101 emit 108 emit 108 emit 111 emit 33 emit cr
;
greet                      \ => Hello!

\ ---
\ Comparisons leave -1 for true and 0 for false.
10 20 <  .                 \ => -1  (true)
cr
5 5   =  .                 \ => -1  (true)
cr

\ ---
\ Control flow:  if ... else ... then   (nonzero = true)
\ abs: negate only when the number is negative
: abs  dup 0 < if 0 swap - then ;
-7 abs .                   \ => 7
cr
7 abs .                    \ => 7
cr

\ max: pick the greater of two values using if/else/then
: max  over over < if swap drop else drop then ;
3 7 max .                  \ => 7
cr
7 3 max .                  \ => 7
cr

